{
  "name": "agent-trajectory",
  "productName": "Agent Trajectory",
  "desktopName": "agent-trajectory.desktop",
  "version": "0.1.0",
  "description": "A local-first, read-only trajectory viewer for multiple coding agents.",
  "author": "Agent Trajectory Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:desktop",
    "build:web": "vite build",
    "build:desktop": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron dist-electron/main.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "verify:real-sources": "tsx scripts/verify-real-sources.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.agenttrajectory.desktop",
    "productName": "Agent Trajectory",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/main.mjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-electron/projection-worker.mjs",
        "to": "workers/projection-worker.mjs"
      },
      {
        "from": "dist-electron/zcode-worker.mjs",
        "to": "workers/zcode-worker.mjs"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
