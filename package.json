{
  "name": "agent-trajectory",
  "productName": "Agent Trajectory",
  "version": "0.1.0",
  "description": "A local-first, read-only trajectory viewer for multiple coding agents.",
  "author": "Agent Trajectory Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiraeth1992/agent-trajectory.git"
  },
  "homepage": "https://github.com/hiraeth1992/agent-trajectory#readme",
  "bugs": {
    "url": "https://github.com/hiraeth1992/agent-trajectory/issues"
  },
  "type": "module",
  "bin": {
    "agent-trajectory": "dist-cli/agent-trajectory.mjs"
  },
  "files": [
    "dist-cli/**/*",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "LICENSE",
    "LICENSE.zh-CN.md"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist-cli/agent-trajectory.mjs",
    "doctor": "npm run build && node dist-cli/agent-trajectory.mjs doctor",
    "pack:tgz": "npm run build && npm pack",
    "preview": "npm run start -- --no-open",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "verify:real-sources": "tsx scripts/verify-real-sources.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fzstd": "^0.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
